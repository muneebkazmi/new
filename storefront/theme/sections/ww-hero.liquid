{{ 'ww-brand.css' | asset_url | stylesheet_tag }}
<section class="ww ww-section ww-hero{% if section.settings.image == blank %} ww-hero--noimage{% endif %}">
  {%- if section.settings.image != blank -%}
    <div class="ww-hero__bg">
      {{ section.settings.image | image_url: width: 2400 | image_tag:
          loading: 'eager', fetchpriority: 'high', sizes: '100vw',
          widths: '600,900,1200,1600,2000,2400',
          alt: section.settings.image.alt | default: shop.name }}
    </div>
  {%- endif -%}
  <div class="ww-hero__scrim"></div>

  <div class="ww-hero__inner">
    <div class="ww-wrap">
      <div class="ww-hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="ww-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h1 class="ww-hero__title">{{ section.settings.title }}</h1>
        {%- if section.settings.lede != blank -%}
          <p class="ww-hero__lede">{{ section.settings.lede }}</p>
        {%- endif -%}
        <div class="ww-hero__cta">
          {%- if section.settings.cta_label != blank -%}
            <a class="ww-btn ww-btn--primary" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
              {{ section.settings.cta_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.cta2_label != blank -%}
            <a class="ww-btn ww-btn--ghost" href="{{ section.settings.cta2_link }}">{{ section.settings.cta2_label }}</a>
          {%- endif -%}
        </div>
        {%- if section.settings.show_ladder -%}
          <div class="ww-ladder">
            <span class="ww-chip">From <strong>{{ section.settings.price_from }}</strong></span>
            <span class="ww-chip"><strong>Cash on Delivery</strong></span>
            <span class="ww-chip"><strong>7-day</strong> replacement</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "W&W Hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Full-bleed behind the text. A dark, moody shot works best. Without one the hero falls back to a warm gradient." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Grooming, watches & home" },
    { "type": "html", "id": "title", "label": "Heading", "default": "Wired <em>and</em> warped." },
    { "type": "textarea", "id": "lede", "label": "Supporting text" },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "Shop the collection" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button", "default": "Our story" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" },
    { "type": "checkbox", "id": "show_ladder", "label": "Show trust chips", "default": true },
    { "type": "text", "id": "price_from", "label": "Lowest price", "default": "Rs 533" }
  ],
  "presets": [{ "name": "W&W Hero" }]
}
{% endschema %}
