{{ 'ww-brand.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Floating WhatsApp CTA. Lives in the footer group so it renders on every page;
  position:fixed lifts it out of footer flow, so DOM placement does not matter.
{%- endcomment -%}
{%- assign ww_wa_number = section.settings.number | remove: '+' | remove: ' ' | remove: '-' -%}
{%- assign ww_wa_text = section.settings.message -%}
<a
  class="ww ww-wa"
  href="https://wa.me/{{ ww_wa_number }}?text={{ ww_wa_text | url_encode }}"
  target="_blank"
  rel="noopener"
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24a8.2 8.2 0 0 1 5.83 2.42 8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23zm4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.24-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29z"/>
  </svg>
  <span class="ww-wa__label">WhatsApp us</span>
  <span class="ww-visually-hidden">Opens WhatsApp in a new tab</span>
</a>

{% schema %}
{
  "name": "W&W WhatsApp button",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "number", "label": "WhatsApp number, country code first", "default": "923053488833" },
    { "type": "textarea", "id": "message", "label": "Pre-filled message", "default": "Hi Wired and Warped, I have a question about an order." }
  ],
  "presets": [{ "name": "W&W WhatsApp button" }]
}
{% endschema %}
